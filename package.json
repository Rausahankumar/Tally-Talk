{
  "name": "tallytalk",
  "version": "0.1.0",
  "private": true,
  "description": "Conversational AI assistant that creates TallyPrime vouchers from natural-language Telegram messages, with backend validation and explicit user confirmation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "tally:sync": "node --env-file=.env src/tally/syncCli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1"
  }
}
