# TallyTalk — required environment variables.
# Copy to .env and fill in real values. NEVER commit .env.

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Shared secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# The webhook rejects any request that does not carry this exact value.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated allowlist of Telegram numeric user IDs permitted to use the bot.
# Any other user is rejected before an LLM call or a Tally write.
TELEGRAM_ALLOWED_USER_IDS=
# Optional. Set only on a deployment with a stable public HTTPS URL (a cloud
# or client machine) — never on local dev, where the webhook has historically
# been registered by hand against whatever tunnel URL is active. When set,
# the app calls Telegram's setWebhook automatically at every startup with
# "<PUBLIC_WEBHOOK_URL>/webhook/telegram" and the secret above — idempotent,
# safe to run on every reboot/service restart. Must start with https:// and
# have no trailing slash. Leave blank to keep registering the webhook
# manually, exactly as before this existed.
PUBLIC_WEBHOOK_URL=

# --- LLM ---
# The call sits behind one module (src/llm/client.ts); only "anthropic" is
# implemented. API key from https://console.anthropic.com — never commit it.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional — defaults to claude-sonnet-5
LLM_MODEL=claude-sonnet-5
# Optional. Only needed for an identity-linked Anthropic API key: the API
# rejects those unless it is told which workspace the request acts in. Leave
# blank for a normal workspace key — the header is then not sent at all.
ANTHROPIC_WORKSPACE_ID=

# --- TallyPrime (LAN / localhost only, never internet-exposed) ---
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
# No company name here — it is discovered dynamically from Tally itself
# (`npm run tally:sync`, see src/tally/company.js), never hardcoded. The
# server reads the synced result and fails closed at startup if it finds
# anything other than exactly one company.

# --- GST Configuration ---
# Backend-controlled GST determination. The LLM never sees or chooses any of
# this — see src/gst/. GST treatment is Company State vs Place of Supply,
# never inferred from the party's state.
#
# Company State is discovered from the same Tally company sync above
# (Company.STATENAME) — not configured here. CGST/SGST/IGST ledgers are
# resolved dynamically per transaction from each Ledger's TAXTYPE/GSTDUTYHEAD
# fields (see src/gst/gstLedgerResolution.js) — never a hardcoded ledger name.
# A missing or ambiguous classification blocks posting; it is never guessed.
#
# Optional. Only set this if you have deliberately decided every transaction
# without a stated Place of Supply defaults to this state. Leave blank to
# always ask the user instead — the safer default. There is no Tally master
# data source for this value (it is a transaction fact, not a master), so it
# remains the one piece of GST configuration set here.
DEFAULT_PLACE_OF_SUPPLY=

# --- Godown ---
# No configuration needed here. When an item's message states no godown, the
# backend automatically resolves one from live stock availability: it
# auto-selects when exactly one godown has sufficient stock, asks you to
# choose when more than one does, and refuses to guess when none do
# (src/gst/postingReadiness.js).

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Storage ---
# SQLite file backing the append-only audit log. The directory is created on
# startup if missing. Back this file up alongside the Tally data directory.
# Optional — defaults to ./data/tallytalk.sqlite
DATABASE_PATH=./data/tallytalk.sqlite
