# TallyTalk — required environment variables.
# Copy to .env and fill in real values. NEVER commit .env.

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Shared secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# The webhook rejects any request that does not carry this exact value.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated allowlist of Telegram numeric user IDs permitted to use the bot.
# Any other user is rejected before an LLM call or a Tally write.
TELEGRAM_ALLOWED_USER_IDS=

# --- LLM ---
# The call sits behind one module (src/llm/client.ts); only "anthropic" is
# implemented. API key from https://console.anthropic.com — never commit it.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional — defaults to claude-sonnet-5
LLM_MODEL=claude-sonnet-5

# --- TallyPrime (LAN / localhost only, never internet-exposed) ---
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_COMPANY_NAME=

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Storage ---
# SQLite file backing the append-only audit log. The directory is created on
# startup if missing. Back this file up alongside the Tally data directory.
# Optional — defaults to ./data/tallytalk.sqlite
DATABASE_PATH=./data/tallytalk.sqlite
